<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="false">

    <!-- 1. WebView Container -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- 2. Offline Fallback Screen -->
    <LinearLayout
        android:id="@+id/offline_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/white"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/offline_image"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:src="@drawable/no_internet"
            android:contentDescription="@string/no_internet_title"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/offline_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_internet_title"
            android:textColor="@color/text_color"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/offline_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_internet_msg"
            android:textColor="#666666"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="@string/retry"
            android:textColor="@color/btn_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/btn_bg"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- 3. Native Login Screen Container -->
    <RelativeLayout
        android:id="@+id/login_screen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Background Video View -->
        <VideoView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true" />

        <!-- Semi-transparent Dark Filter Layer to ensure legibility -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />

        <!-- Scrollable Login UI Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="70dp"
                android:paddingBottom="48dp">

                <!-- App Icon -->
                <ImageView
                    android:id="@+id/login_app_icon"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/app_icon"
                    android:contentDescription="Yaraan App Icon"
                    android:scaleType="fitCenter" />

                <!-- App Title -->
                <TextView
                    android:id="@+id/login_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YARAAN"
                    android:textColor="@color/white"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium" />

                <!-- Spacer Line -->
                <View
                    android:layout_width="60dp"
                    android:layout_height="2dp"
                    android:background="#80FFFFFF"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="120dp" />

                <!-- Google Sign-In Button (Beautifully styled) -->
                <LinearLayout
                    android:id="@+id/btn_google_signin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_google_btn"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="24dp"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_google"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Google G" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Continue with Google"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Circular Email Toggle Button -->
                <ImageButton
                    android:id="@+id/btn_email_toggle"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_circle_btn"
                    android:src="@drawable/ic_mail"
                    android:tint="@color/white"
                    android:scaleType="centerInside"
                    android:layout_marginBottom="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Email Sign In" />

                <!-- Credentials Card (Glassmorphic form, hidden by default) -->
                <LinearLayout
                    android:id="@+id/credentials_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_form"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/tv_form_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOG IN"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_gravity="center"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.05" />

                    <!-- Name Field (Only shown in Sign Up mode) -->
                    <EditText
                        android:id="@+id/et_name"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_edit_text"
                        android:hint="Full Name"
                        android:textColorHint="#99FFFFFF"
                        android:textColor="@color/white"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:textSize="15sp"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone" />

                    <!-- Email Field -->
                    <EditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_edit_text"
                        android:hint="Email Address"
                        android:textColorHint="#99FFFFFF"
                        android:textColor="@color/white"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textSize="15sp"
                        android:layout_marginBottom="16dp" />

                    <!-- Password Field -->
                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_edit_text"
                        android:hint="Password"
                        android:textColorHint="#99FFFFFF"
                        android:textColor="@color/white"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp" />

                    <!-- Forgot Password Link -->
                    <TextView
                        android:id="@+id/btn_forgot_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forgot Password?"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_gravity="end"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Action Button -->
                    <Button
                        android:id="@+id/btn_native_login"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_button"
                        app:backgroundTint="@null"
                        android:text="Log In"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                    <!-- Footer toggle link -->
                    <LinearLayout
                        android:id="@+id/toggle_footer_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="20dp">

                        <TextView
                            android:id="@+id/tv_toggle_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Don't have an account? "
                            android:textColor="#B3FFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btn_toggle_signup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Create Account"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </RelativeLayout>

    <!-- 4. Glassmorphism Loading Overlay -->
    <RelativeLayout
        android:id="@+id/glass_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:id="@+id/glass_loading_card"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_centerInParent="true"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#26FFFFFF"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_card_stroke">

                <ProgressBar
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/white" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>

    <!-- 5. Splash Screen Overlay -->
    <RelativeLayout
        android:id="@+id/splash_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/splash_bg"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_centerInParent="true">

            <ImageView
                android:id="@+id/splash_icon"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/app_icon"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/splash_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/purple_500"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>