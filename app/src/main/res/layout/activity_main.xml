<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="false">

    <!-- 1. WebView Container with top padding slot -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- 2. Offline Fallback Screen -->
    <LinearLayout
        android:id="@+id/offline_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/white"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/offline_image"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:src="@drawable/no_internet"
            android:contentDescription="@string/no_internet_title"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/offline_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_internet_title"
            android:textColor="@color/text_color"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/offline_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_internet_msg"
            android:textColor="#666666"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="@string/retry"
            android:textColor="@color/btn_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/btn_bg"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- 3. Splash Screen Overlay -->
    <RelativeLayout
        android:id="@+id/splash_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/splash_bg"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_centerInParent="true">

            <ImageView
                android:id="@+id/splash_icon"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/app_icon"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/splash_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/purple_500"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 4. Native Login Screen Overlay -->
    <RelativeLayout
        android:id="@+id/native_login_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:fitsSystemWindows="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="32dp">

                <!-- Logo -->
                <ImageView
                    android:id="@+id/login_logo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="80dp"
                    android:src="@drawable/app_icon"
                    android:contentDescription="@string/app_name" />

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 𝐘𝐚𝐫𝐚𝐚𝐧 ★"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOICE CHAT &amp; PARTY"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="4dp" />

                <!-- Card/Box Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#110C24"
                    android:padding="24dp"
                    android:layout_marginTop="48dp"
                    android:elevation="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email Login"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="24dp" />

                    <!-- Email Input -->
                    <EditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#1E1738"
                        android:hint="Email"
                        android:textColorHint="#9CA3AF"
                        android:textColor="#FFFFFF"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:inputType="textEmailAddress"
                        android:singleLine="true"
                        android:layout_marginBottom="16dp" />

                    <!-- Password Input -->
                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#1E1738"
                        android:hint="Password"
                        android:textColorHint="#9CA3AF"
                        android:textColor="#FFFFFF"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:layout_marginBottom="12dp" />

                    <!-- Forgot Password Link -->
                    <TextView
                        android:id="@+id/tv_forgot_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forgot Password?"
                        android:textColor="#FF6200EE"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_gravity="end"
                        android:layout_marginBottom="20dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Login Button -->
                    <Button
                        android:id="@+id/btn_native_login"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Sign In"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:backgroundTint="#FF6200EE"
                        android:layout_marginBottom="16dp" />

                    <!-- Google Sign In Button -->
                    <Button
                        android:id="@+id/btn_native_google"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Sign in with Google"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:backgroundTint="#FFFFFF" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </RelativeLayout>

</RelativeLayout>
