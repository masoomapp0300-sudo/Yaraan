<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="false">

    <!-- 1. WebView Container with top padding slot (Always true edge-to-edge fullscreen) -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- 2. Offline Fallback Screen -->
    <LinearLayout
        android:id="@+id/offline_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/white"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/offline_image"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:src="@drawable/no_internet"
            android:contentDescription="@string/no_internet_title"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/offline_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_internet_title"
            android:textColor="@color/text_color"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/offline_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_internet_msg"
            android:textColor="#666666"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="@string/retry"
            android:textColor="@color/btn_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/btn_bg"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- 3. Splash Screen Overlay -->
    <RelativeLayout
        android:id="@+id/splash_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/splash_bg"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_centerInParent="true">

            <ImageView
                android:id="@+id/splash_icon"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/app_icon"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/splash_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/purple_500"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 4. Native Login Screen Parent Container -->
    <RelativeLayout
        android:id="@+id/native_login_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- Background VideoView playing bg_login.mp4 edge-to-edge -->
        <VideoView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true" />

        <!-- Semi-transparent overlay to ensure contrast and readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#4D000000" />

        <!-- SECTION A: Initial Native Login Screen (Pill buttons for Google and Email) -->
        <RelativeLayout
            android:id="@+id/section_initial_login"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <!-- 1. Top Section: Logo and App Name shifted to the very top section -->
            <LinearLayout
                android:id="@+id/top_logo_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_alignParentTop="true"
                android:layout_marginTop="40dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp">

                <!-- Logo -->
                <ImageView
                    android:id="@+id/login_logo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/app_icon"
                    android:contentDescription="@string/app_name" />

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 𝐘𝐚𝐫𝐚𝐚𝐧 ★"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOICE CHAT &amp; PARTY"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 3. Bottom Section: Privacy Policy shifted to the very bottom of the screen -->
            <LinearLayout
                android:id="@+id/bottom_privacy_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="24dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <CheckBox
                    android:id="@+id/cb_privacy_policy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FFFFFF"
                    android:checked="false" />

                <TextView
                    android:id="@+id/tv_privacy_policy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I agree to the Privacy Policy"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- 2. Mid-Low Section: Sign-in buttons positioned lower down, leaving center video area highly visible -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal|bottom"
                android:layout_above="@id/bottom_privacy_container"
                android:layout_below="@id/top_logo_container"
                android:layout_marginBottom="24dp"
                android:paddingStart="40dp"
                android:paddingEnd="40dp">

                <!-- Empty space weight to push buttons down to lower area -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Google Sign-In Button (Fully rounded pill shaped / smooth curves) -->
                <LinearLayout
                    android:id="@+id/btn_native_google"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_google_btn"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:elevation="4dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_google"
                        android:contentDescription="Google" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign in with Google"
                        android:textColor="#333333"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <!-- Clean, minimalist white Email Icon ONLY positioned neatly below the Google button -->
                <ImageView
                    android:id="@+id/btn_open_email_screen"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_email"
                    android:scaleType="fitCenter"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginTop="16dp"
                    android:contentDescription="Email Sign-In" />
            </LinearLayout>

        </RelativeLayout>

        <!-- SECTION B: Dedicated Full-Screen Email/Password Entry (with Login / Register / Forgot Password modes) -->
        <RelativeLayout
            android:id="@+id/section_email_login"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Back Arrow Button to return to initial native screen -->
            <ImageView
                android:id="@+id/btn_back_to_initial"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_back"
                android:padding="12dp"
                android:layout_marginTop="48dp"
                android:layout_marginStart="16dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/btn_back_to_initial"
                android:fillViewport="true"
                android:fitsSystemWindows="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:gravity="center_horizontal">

                    <!-- Title of the screen/form -->
                    <TextView
                        android:id="@+id/tv_form_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign In"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:layout_marginTop="24dp" />

                    <!-- Form Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#221A44"
                        android:padding="24dp"
                        android:layout_marginTop="32dp"
                        android:elevation="4dp">

                        <!-- Name Input (Only shown in Register/Create Account mode) -->
                        <EditText
                            android:id="@+id/et_name"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="#1E1738"
                            android:hint="Full Name"
                            android:textColorHint="#9CA3AF"
                            android:textColor="#FFFFFF"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:inputType="textPersonName"
                            android:singleLine="true"
                            android:layout_marginBottom="16dp"
                            android:visibility="gone" />

                        <!-- Email Input -->
                        <EditText
                            android:id="@+id/et_email"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="#1E1738"
                            android:hint="Email"
                            android:textColorHint="#9CA3AF"
                            android:textColor="#FFFFFF"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:inputType="textEmailAddress"
                            android:singleLine="true"
                            android:layout_marginBottom="16dp" />

                        <!-- Password Input -->
                        <EditText
                            android:id="@+id/et_password"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="#1E1738"
                            android:hint="Password"
                            android:textColorHint="#9CA3AF"
                            android:textColor="#FFFFFF"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:layout_marginBottom="12dp" />

                        <!-- Forgot Password Link -->
                        <TextView
                            android:id="@+id/tv_forgot_password"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Forgot Password?"
                            android:textColor="#FF6200EE"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_gravity="end"
                            android:layout_marginBottom="24dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- Native Submit/Action Button -->
                        <Button
                            android:id="@+id/btn_native_login"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Sign In"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:backgroundTint="#FF6200EE"
                            android:layout_marginBottom="16dp" />

                    </LinearLayout>

                    <!-- Toggle Mode link -->
                    <TextView
                        android:id="@+id/tv_toggle_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Don't have an account? Create one"
                        android:textColor="#9CA3AF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="24dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </ScrollView>

        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>
